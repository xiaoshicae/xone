{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://github.com/xiaoshicae/xone",
  "title": "XOne配置",
  "type": "object",
  "properties": {
    "Server": {
      "type": "object",
      "description": "服务配置",
      "properties": {
        "Name": {
          "type": "string",
          "description": "服务名"
        },
        "Version": {
          "type": "string",
          "description": "服务版本号，默认v0.0.1"
        },
        "Profiles": {
          "type": "object",
          "description": "环境相关配置",
          "properties": {
            "Active": {
              "type": "string",
              "description": "指定启用的环境"
            }
          }
        }
      }
    },
    "XGin": {
      "type": "object",
      "description": "Gin Web 框架配置",
      "properties": {
        "Host": {
          "type": "string",
          "description": "服务监听的host，默认0.0.0.0"
        },
        "Port": {
          "type": ["integer", "string"],
          "description": "服务监听的端口，默认8080"
        },
        "UseH2C": {
          "type": ["boolean", "string"],
          "description": "是否启用 h2c（HTTP/2 Cleartext，非 TLS 下的 HTTP/2），默认 false"
        },
        "CertFile": {
          "type": "string",
          "description": "TLS 证书路径，配置后自动启用 HTTPS"
        },
        "KeyFile": {
          "type": "string",
          "description": "TLS 私钥路径，需与 CertFile 同时配置"
        },
        "ReadHeaderTimeout": {
          "type": "string",
          "description": "读取请求头的超时时间，默认 10s。不设置则慢客户端可以一直占着连接不放"
        },
        "ReadTimeout": {
          "type": "string",
          "description": "读取整个请求（含 body）的超时时间，默认不限制。限制它会打断大文件上传等长时间请求"
        },
        "WriteTimeout": {
          "type": "string",
          "description": "写响应的超时时间，默认不限制。限制它会打断 SSE、长轮询、大文件下载"
        },
        "IdleTimeout": {
          "type": "string",
          "description": "keep-alive 连接的空闲超时时间，默认 60s"
        },
        "GracefulStopTimeout": {
          "type": "string",
          "description": "优雅退出超时，默认 25s。应小于部署环境的进程终止宽限期（如 K8s terminationGracePeriodSeconds）"
        },
        "Swagger": {
          "type": "object",
          "description": "swagger相关配置",
          "properties": {
            "Host": {
              "type": "string",
              "description": "提供api服务的host"
            },
            "BasePath": {
              "type": "string",
              "description": "api公共前缀"
            },
            "Title": {
              "type": "string",
              "description": "api管理后台的title"
            },
            "Description": {
              "type": "string",
              "description": "api管理后台的描述信息"
            },
            "Schemes": {
              "type": "array",
              "description": "api支持的协议，默认[https, http]",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "XLog": {
      "type": "object",
      "description": "日志配置。Level 与 Timezone 为两路输出共用，控制台与文件各自的配置分别位于 Console 与 File 子块",
      "additionalProperties": false,
      "properties": {
        "Level": {
          "description": "日志级别，两路输出共用，默认info，大小写不敏感",
          "default": "info",
          "allOf": [{ "$ref": "#/definitions/LogLevel" }]
        },
        "Timezone": {
          "type": "string",
          "minLength": 1,
          "description": "日志时间的时区(IANA时区名)，两路输出共用，默认Asia/Shanghai，加载失败时回退到系统本地时区",
          "default": "Asia/Shanghai"
        },
        "Console": {
          "type": "object",
          "description": "控制台(标准输出)配置",
          "additionalProperties": false,
          "properties": {
            "Enable": {
              "description": "是否输出到控制台，默认true；与File.Enable同时为false时会被强制置为true",
              "default": true,
              "allOf": [{ "$ref": "#/definitions/BoolOrPlaceholder" }]
            },
            "Format": {
              "description": "输出格式，text为带颜色的可读格式，json为结构化格式；容器环境建议使用json，默认text",
              "default": "text",
              "allOf": [{ "$ref": "#/definitions/LogConsoleFormat" }]
            }
          }
        },
        "File": {
          "type": "object",
          "description": "日志文件配置。默认不写文件，仅打印到标准输出",
          "additionalProperties": false,
          "properties": {
            "Enable": {
              "description": "是否将日志写入文件，默认false（适配K8s等由采集器收集容器标准输出的环境）",
              "default": false,
              "allOf": [{ "$ref": "#/definitions/BoolOrPlaceholder" }]
            },
            "Path": {
              "type": "string",
              "minLength": 1,
              "description": "日志文件夹路径，默认./log",
              "default": "./log"
            },
            "Name": {
              "type": "string",
              "minLength": 1,
              "description": "日志文件名称，实际文件形如{Name}.log.20260912，默认app",
              "default": "app"
            },
            "MaxAge": {
              "description": "日志保存最大时长，超过该时长的历史文件会在轮转时清理，设为0表示不清理，默认7d",
              "default": "7d",
              "allOf": [{ "$ref": "#/definitions/Duration" }]
            },
            "RotateTime": {
              "description": "日志切割周期，最小1m（文件名时间后缀最细到分钟），默认1d",
              "default": "1d",
              "allOf": [{ "$ref": "#/definitions/Duration" }]
            },
            "Perm": {
              "type": "string",
              "description": "日志文件权限，八进制字符串，默认0644。日志可能含敏感信息，需要限制同机其他用户读取时配0600",
              "default": "0644"
            }
          }
        }
      }
    },
    "XFlow": {
      "type": "object",
      "description": "流程编排配置",
      "properties": {
        "EnableMonitor": {
          "type": ["boolean", "string"],
          "description": "是否开启流程监控，默认true"
        },
        "RollbackTimeout": {
          "type": "string",
          "description": "回滚全部处理器的总超时，默认30s。回滚不沿用调用方context（否则请求超时后补偿必然失败），由本项单独限时"
        }
      }
    },
    "XTrace": {
      "type": "object",
      "description": "链路追踪配置",
      "properties": {
        "Enable": {
          "type": ["boolean", "string"],
          "description": "Trace是否开启，默认true"
        },
        "EnableConsole": {
          "type": ["boolean", "string"],
          "description": "是否要在控制台打印trace内容，仅用于本地调试，默认false"
        },
        "SampleRatio": {
          "type": ["number", "string"],
          "description": "采样率，取值(0,1]，>=1时全采样，默认1.0。完全关闭链路请用Enable=false"
        },
        "ShutdownTimeout": {
          "type": "string",
          "description": "关闭时等待Span导出完成的上限，默认5s。仅在通过xtrace.AddSpanProcessor注册了上报处理器时有实际意义"
        },
        "ForwardHeaders": {
          "type": "array",
          "description": "全局透传的自定义HTTP Header列表，向所有下游服务透传（如X-Request-Id），配置后自动从上游请求提取并注入下游请求",
          "items": {
            "type": "string"
          }
        },
        "ForwardHeaderRules": {
          "type": "array",
          "description": "按域名透传的Header规则列表，仅当请求目标域名匹配时才透传对应Header，防止敏感Header泄漏到第三方服务",
          "items": {
            "type": "object",
            "properties": {
              "Domains": {
                "type": "array",
                "description": "域名模式列表，支持精确匹配（如api.example.com）和通配符前缀（如*.svc.cluster.local），匹配时忽略端口和大小写",
                "items": {
                  "type": "string"
                }
              },
              "Headers": {
                "type": "array",
                "description": "该规则下要透传的Header列表，仅当目标域名匹配Domains中的任一模式时才注入",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["Domains", "Headers"]
          }
        }
      }
    },
    "XMetric": {
      "type": "object",
      "description": "Prometheus 指标采集配置",
      "properties": {
        "Namespace": {
          "type": "string",
          "description": "指标命名空间前缀，如 myapp，设置后所有指标名会加上该前缀（如 myapp_http_requests_total）"
        },
        "ConstLabels": {
          "type": "object",
          "description": "全局常量标签，自动附加到所有指标上，典型用途：区分环境（env=prod）、集群（cluster=cn-east）",
          "additionalProperties": {
            "type": "string"
          }
        },
        "HttpDurationBuckets": {
          "type": "array",
          "description": "HTTP 入站/出站请求耗时 Histogram 桶边界（秒），影响 http_request_duration_seconds 和 http_client_request_duration_seconds，默认 [0.001,0.005,0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10]",
          "items": {
            "type": "number"
          }
        },
        "HistogramObserveBuckets": {
          "type": "array",
          "description": "通过 HistogramObserve() API 创建的业务 Histogram 默认桶边界（秒），默认 prometheus.DefBuckets",
          "items": {
            "type": "number"
          }
        },
        "EnableGoMetrics": {
          "type": ["boolean", "string"],
          "description": "是否启用 Go runtime 指标（goroutine 数、GC 等），默认 true"
        },
        "EnableProcessMetrics": {
          "type": ["boolean", "string"],
          "description": "是否启用进程指标（CPU、内存、文件描述符等），默认 true"
        },
        "EnableLogErrorMetric": {
          "type": ["boolean", "string"],
          "description": "是否启用 xlog.Error 自动上报 metric（log_errors_total），默认 true"
        }
      }
    },
    "XHttp": {
      "type": "object",
      "description": "HTTP客户端配置",
      "properties": {
        "Timeout": {
          "type": "string",
          "description": "HTTP 请求超时时间，默认60s"
        },
        "DialTimeout": {
          "type": "string",
          "description": "建立 TCP 连接超时时间，默认30s"
        },
        "DialKeepAlive": {
          "type": "string",
          "description": "TCP keep-alive 探测间隔，默认30s"
        },
        "MaxIdleConns": {
          "type": ["integer", "string"],
          "description": "最大空闲连接数，默认100"
        },
        "MaxIdleConnsPerHost": {
          "type": ["integer", "string"],
          "description": "每个 host 最大空闲连接数，默认10"
        },
        "IdleConnTimeout": {
          "type": "string",
          "description": "空闲连接超时时间，默认90s"
        },
        "RetryCount": {
          "type": ["integer", "string"],
          "description": "重试次数，默认0（不重试）"
        },
        "RetryWaitTime": {
          "type": "string",
          "description": "重试等待时间，默认100ms"
        },
        "RetryMaxWaitTime": {
          "type": "string",
          "description": "最大重试等待时间，默认2s"
        },
        "RetryOnlyIdempotent": {
          "type": ["boolean", "string"],
          "description": "是否只对幂等方法（GET/HEAD/OPTIONS/TRACE/PUT/DELETE）重试，默认 true。超时无法区分「请求没到服务端」和「服务端处理完了但响应丢了」，重发 POST 可能导致重复下单"
        },
        "EnableMetric": {
          "type": ["boolean", "string"],
          "description": "是否启用出站请求 Prometheus 指标采集（http_client_requests_total / http_client_request_duration_seconds），默认 true"
        }
      }
    },
    "XRedis": {
      "type": ["object", "array"],
      "description": "Redis 配置，单实例用对象、多实例用数组（数组元素必须配 Name）",
      "items": { "$ref": "#/definitions/RedisConfig" },
      "properties": {
        "Addr": { "$ref": "#/definitions/RedisConfig/properties/Addr" },
        "Username": { "$ref": "#/definitions/RedisConfig/properties/Username" },
        "Password": { "$ref": "#/definitions/RedisConfig/properties/Password" },
        "DB": { "$ref": "#/definitions/RedisConfig/properties/DB" },
        "DialTimeout": { "$ref": "#/definitions/RedisConfig/properties/DialTimeout" },
        "ReadTimeout": { "$ref": "#/definitions/RedisConfig/properties/ReadTimeout" },
        "WriteTimeout": { "$ref": "#/definitions/RedisConfig/properties/WriteTimeout" },
        "PoolSize": { "$ref": "#/definitions/RedisConfig/properties/PoolSize" },
        "MinIdleConns": { "$ref": "#/definitions/RedisConfig/properties/MinIdleConns" },
        "MaxIdleConns": { "$ref": "#/definitions/RedisConfig/properties/MaxIdleConns" },
        "MaxActiveConns": { "$ref": "#/definitions/RedisConfig/properties/MaxActiveConns" },
        "PoolTimeout": { "$ref": "#/definitions/RedisConfig/properties/PoolTimeout" },
        "ConnMaxIdleTime": { "$ref": "#/definitions/RedisConfig/properties/ConnMaxIdleTime" },
        "ConnMaxLifetime": { "$ref": "#/definitions/RedisConfig/properties/ConnMaxLifetime" },
        "MaxRetries": { "$ref": "#/definitions/RedisConfig/properties/MaxRetries" },
        "MinRetryBackoff": { "$ref": "#/definitions/RedisConfig/properties/MinRetryBackoff" },
        "MaxRetryBackoff": { "$ref": "#/definitions/RedisConfig/properties/MaxRetryBackoff" },
        "EnableMetric": { "$ref": "#/definitions/RedisConfig/properties/EnableMetric" },
        "Name": { "$ref": "#/definitions/RedisConfig/properties/Name" }
      }
    },
    "XCache": {
      "type": ["object", "array"],
      "description": "本地缓存配置（基于 ristretto），单实例用对象、多实例用数组（数组元素必须配 Name）",
      "items": { "$ref": "#/definitions/CacheConfig" },
      "properties": {
        "NumCounters": { "$ref": "#/definitions/CacheConfig/properties/NumCounters" },
        "MaxCost": { "$ref": "#/definitions/CacheConfig/properties/MaxCost" },
        "BufferItems": { "$ref": "#/definitions/CacheConfig/properties/BufferItems" },
        "DefaultTTL": { "$ref": "#/definitions/CacheConfig/properties/DefaultTTL" },
        "Name": { "$ref": "#/definitions/CacheConfig/properties/Name" }
      }
    },
    "XGorm": {
      "type": [
        "object",
        "array"
      ],
      "description": "数据库配置(支持MySQL和PostgreSQL)",
      "items": {
        "$ref": "#/definitions/GormConfig"
      },
      "properties": {
        "Driver": {
          "$ref": "#/definitions/GormConfig/properties/Driver"
        },
        "DSN": {
          "$ref": "#/definitions/GormConfig/properties/DSN"
        },
        "DialTimeout": {
          "$ref": "#/definitions/GormConfig/properties/DialTimeout"
        },
        "MySQL": {
          "$ref": "#/definitions/GormConfig/properties/MySQL"
        },
        "Postgres": {
          "$ref": "#/definitions/GormConfig/properties/Postgres"
        },
        "MaxOpenConns": {
          "$ref": "#/definitions/GormConfig/properties/MaxOpenConns"
        },
        "MaxIdleConns": {
          "$ref": "#/definitions/GormConfig/properties/MaxIdleConns"
        },
        "MaxLifetime": {
          "$ref": "#/definitions/GormConfig/properties/MaxLifetime"
        },
        "MaxIdleTime": {
          "$ref": "#/definitions/GormConfig/properties/MaxIdleTime"
        },
        "EnableLog": {
          "$ref": "#/definitions/GormConfig/properties/EnableLog"
        },
        "EnableMetric": {
          "$ref": "#/definitions/GormConfig/properties/EnableMetric"
        },
        "SlowThreshold": {
          "$ref": "#/definitions/GormConfig/properties/SlowThreshold"
        },
        "IgnoreRecordNotFoundErrorLog": {
          "$ref": "#/definitions/GormConfig/properties/IgnoreRecordNotFoundErrorLog"
        },
        "Name": {
          "$ref": "#/definitions/GormConfig/properties/Name"
        }
      }
    }
  },
  "required": [],
  "definitions": {
    "BoolOrPlaceholder": {
      "description": "布尔值，也可写成字符串形式的布尔值，或${ENV}/${ENV:-default}环境变量占位符",
      "anyOf": [
        { "type": "boolean" },
        {
          "type": "string",
          "pattern": "^(true|True|TRUE|false|False|FALSE|t|T|f|F|1|0|\\$\\{[^}]*\\})$"
        }
      ]
    },
    "Duration": {
      "type": "string",
      "description": "时间长度，支持d(天)前缀与Go duration单位(ns/us/ms/s/m/h)，如7d、1d12h、500ms；也支持${ENV}/${ENV:-default}环境变量占位符",
      "pattern": "^(\\d+d(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))*|(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+|\\$\\{[^}]*\\})$"
    },
    "LogConsoleFormat": {
      "description": "控制台输出格式，也支持${ENV}/${ENV:-default}环境变量占位符",
      "anyOf": [
        {
          "type": "string",
          "enum": ["text", "json", "TEXT", "JSON"]
        },
        {
          "type": "string",
          "pattern": "^\\$\\{[^}]*\\}$"
        }
      ]
    },
    "LogLevel": {
      "description": "日志级别，也支持${ENV}/${ENV:-default}环境变量占位符",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "fatal",
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR",
            "FATAL"
          ]
        },
        {
          "type": "string",
          "pattern": "^\\$\\{[^}]*\\}$"
        }
      ]
    },
    "RedisConfig": {
      "type": "object",
      "properties": {
        "Addr": { "type": "string", "description": "Redis 服务器地址，默认 localhost:6379" },
        "Username": { "type": "string", "description": "Redis 6.0+ ACL 用户名" },
        "Password": { "type": "string", "description": "Redis 认证密码，建议用 ${VAR} 形式从环境变量注入" },
        "DB": { "type": ["integer", "string"], "description": "数据库编号，默认 0" },
        "DialTimeout": { "type": "string", "description": "建立连接超时时间，默认 500ms" },
        "ReadTimeout": { "type": "string", "description": "读超时时间，默认 500ms" },
        "WriteTimeout": { "type": "string", "description": "写超时时间，默认 500ms" },
        "PoolSize": { "type": ["integer", "string"], "description": "连接池最大连接数，默认由 go-redis 决定（10 * GOMAXPROCS）" },
        "MinIdleConns": { "type": ["integer", "string"], "description": "最小空闲连接数，默认 5。多实例时每个实例都会常驻这么多连接" },
        "MaxIdleConns": { "type": ["integer", "string"], "description": "最大空闲连接数，默认无限制" },
        "MaxActiveConns": { "type": ["integer", "string"], "description": "最大活跃连接数，默认无限制" },
        "PoolTimeout": { "type": "string", "description": "从连接池获取连接的超时时间，默认 1s" },
        "ConnMaxIdleTime": { "type": "string", "description": "空闲连接最大存活时间，默认 5m" },
        "ConnMaxLifetime": { "type": "string", "description": "连接最大存活时间，默认 5m" },
        "MaxRetries": { "type": ["integer", "string"], "description": "最大重试次数，默认由 go-redis 决定（3 次），-1 禁用" },
        "MinRetryBackoff": { "type": "string", "description": "最小重试退避时间，默认由 go-redis 决定（8ms），\"-1\" 禁用" },
        "MaxRetryBackoff": { "type": "string", "description": "最大重试退避时间，默认由 go-redis 决定（512ms），\"-1\" 禁用" },
        "EnableMetric": { "type": ["boolean", "string"], "description": "是否启用连接池 Prometheus 指标采集（redis_pool_*），默认 true。指标在 scrape 时实时读取 redis.PoolStats()，不额外占用协程" },
        "Name": { "type": "string", "description": "多实例配置时的唯一标识，数组形式下必填" }
      }
    },
    "CacheConfig": {
      "type": "object",
      "properties": {
        "NumCounters": { "type": ["integer", "string"], "description": "用于跟踪频率的键数量，建议为期望缓存条目数的 10 倍，默认 1000000" },
        "MaxCost": { "type": ["integer", "string"], "description": "缓存最大成本，每个条目 cost=1 时等价于最大条目数，默认 100000" },
        "BufferItems": { "type": ["integer", "string"], "description": "Get 操作的内部缓冲区大小，默认 64" },
        "DefaultTTL": { "type": "string", "description": "默认缓存过期时间，默认 5m" },
        "Name": { "type": "string", "description": "多实例配置时的唯一标识，数组形式下必填" }
      }
    },
    "GormConfig": {
      "type": "object",
      "properties": {
        "Driver": {
          "type": "string",
          "enum": [
            "mysql",
            "postgres"
          ],
          "description": "数据库驱动类型，默认postgres"
        },
        "DSN": {
          "type": "string",
          "description": "数据库连接字符串"
        },
        "DialTimeout": {
          "type": "string",
          "description": "建连超时时间，默认500ms(MySQL→timeout, PG→connect_timeout)"
        },
        "MySQL": {
          "type": "object",
          "description": "MySQL 驱动特化配置(仅 Driver=mysql 时生效)",
          "properties": {
            "ReadTimeout": {
              "type": "string",
              "description": "MySQL DSN 的 readTimeout，默认3s"
            },
            "WriteTimeout": {
              "type": "string",
              "description": "MySQL DSN 的 writeTimeout，默认5s"
            }
          }
        },
        "Postgres": {
          "type": "object",
          "description": "PostgreSQL 驱动特化配置(仅 Driver=postgres 时生效)，会注入 DSN 为会话级 GUC",
          "properties": {
            "StatementTimeout": {
              "type": "string",
              "description": "PG statement_timeout，单条 SQL 最长执行时间，默认不限制"
            },
            "LockTimeout": {
              "type": "string",
              "description": "PG lock_timeout，等锁最长时间，默认不限制"
            },
            "IdleInTxTimeout": {
              "type": "string",
              "description": "PG idle_in_transaction_session_timeout，事务内空闲超时，默认不限制"
            },
            "Params": {
              "type": "object",
              "description": "其它任意 PG runtime param 直通(如 application_name、timezone 等)",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "MaxOpenConns": {
          "type": ["integer", "string"],
          "description": "最大连接数，默认50"
        },
        "MaxIdleConns": {
          "type": ["integer", "string"],
          "description": "最大空闲连接数，默认等于MaxOpenConns；显式配 0 表示不保留任何空闲连接"
        },
        "MaxLifetime": {
          "type": "string",
          "description": "连接最大存活时间，默认5m"
        },
        "MaxIdleTime": {
          "type": "string",
          "description": "空闲连接的最长存活时间，默认等于MaxLifetime"
        },
        "EnableLog": {
          "type": ["boolean", "string"],
          "description": "是否开启日志(开启后SQL日志将记录到应用的log文件中)，默认false"
        },
        "EnableMetric": {
          "type": ["boolean", "string"],
          "description": "是否启用连接池 Prometheus 指标采集（db_connections_*），默认 true。指标在 scrape 时实时读取 sql.DB.Stats()，不额外占用协程"
        },
        "SlowThreshold": {
          "type": "string",
          "description": "慢查询日志阈值(如果开启日志，慢查询会记录到日志)，默认3s"
        },
        "IgnoreRecordNotFoundErrorLog": {
          "type": ["boolean", "string"],
          "description": "是否忽略未查询到结果的错误日志记录，默认false"
        },
        "Name": {
          "type": "string",
          "description": "用于区分多数据库配置时的唯一标识(多数据库时必填)"
        }
      }
    }
  }
}
